# Isi dengan API key Anthropic kamu, jangan pernah commit file .env asli ke git
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# Model yang dipakai. Ganti ke claude-haiku-4-5-20251001 kalau mau lebih hemat biaya
CLAUDE_MODEL=claude-sonnet-4-6

# Port server
PORT=3000

# Key sederhana buat proteksi endpoint dari akses acak (ganti dengan string acak sendiri)
APP_SECRET=ganti-dengan-string-rahasia-kamu
